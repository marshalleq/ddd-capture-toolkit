# Ignore large disk images
*.iso
*.mp4
*.wav
*.flac
*.lds
*.tbc
temp/*
media/iso/*
media/mp4/*
deleteme.txt
run*
TIMING_CALIBTRATION_REFERENCE.md

# But do NOT ignore this specific mp4 file
!media/mp4/sync_test_10s.mp4

# Ignore user-specific configuration files
config.json

# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Internal documentation (not for public mirror)
Documents/
deleteme.txt
ArchitecturePrompt.txt
build.txt

# macOS files
.DS_Store
.DS_Store?

# Job queue and log files (contain user-specific data)
config/job_queue.json
logs/
workflow_debug.log
*.log

# Debug output files
debug_*.txt
test_*.txt
whatidid.txt

# PyTorch3D build artifacts
pytorch3d

# Personal/development notes (may contain paths)
CRITICAL_UPDATES_COMPLETE.md
pendingchanges.txt
SESSION_*.md

# Downloaded AppImages (easy mode binaries)
tools/*.AppImage

# Build artifacts (performance mode compilation)
build/

# Benchmarks
benchmarks/

